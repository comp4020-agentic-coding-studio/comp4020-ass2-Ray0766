---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import DefaultDarkTheme from "../../components/DefaultDarkTheme.astro";
import LadderRail from "../../components/lecture/LadderRail.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import WeekPager from "../../components/WeekPager.astro";
import WeekStrip from "../../components/WeekStrip.astro";
import { formatCourseDate } from "../../lib/dates";
import { phaseForWeek } from "../../lib/phases";
import { graphCollections, siteConfig } from "../../site-config";
import "../../styles/site.css";
import "../../styles/lecture-phases.css";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
// The phase decides the shape of the page, not just a colour --- see
// src/styles/lecture-phases.css. It goes on `<main>` itself through the
// theme's `mainAttrs` rather than on a wrapper div, because the type scale in
// site.css is scoped to `.at-main > h1/h2/h3` and any wrapper would put the
// MDX body one level too deep for it.
const phase = phaseForWeek(lecture.data.week);
---

<ContentLayout
  title={title}
  description={lecture.data.description}
  mainAttrs={{ "data-phase": phase.key }}
  {...siteConfig}
>
  <DefaultDarkTheme slot="head" />
  <p><strong>{formatCourseDate(lecture.data.date)}</strong></p>
  <WeekStrip week={lecture.data.week} highlight="lectures" />
  {lecture.data.slides && <p><a href={withBase(lecture.data.slides)}>Open the slides</a></p>}
  {/* The bench's rail, for the four generator weeks: styled out of the way
      below 1440px, where the ladder in the prose is the whole of it. */}
  {phase.key === "generators" && <LadderRail week={lecture.data.week} />}
  <Content />
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
  <WeekPager collection="lectures" week={lecture.data.week} />

  {phase.key === "generators" && <script src="../../scripts/lecture-bench.ts" />}
</ContentLayout>
