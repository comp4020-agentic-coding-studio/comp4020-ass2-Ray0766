---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const lectures = await getPublishedCollection("lectures");
const routes = lectures.filter((lecture) => lecture.data.slides).map((lecture) => ({
  deck: withBase(lecture.data.slides!),
  lecture: withBase(`/lectures/${lecture.id}/`),
  label: `Week ${lecture.data.week} · Lecture`,
}));
---

<template data-deck-routes={JSON.stringify(routes)} />
<script src="../../scripts/deck-focus.ts"></script>
<script src="../../scripts/deck-navigation.ts"></script>
