---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

interface Props {
  week: number;
  highlight: "lectures" | "sessions";
}

const { week, highlight } = Astro.props;

const [lectures, sessions, assessments] = await Promise.all([
  getPublishedCollection("lectures"),
  getPublishedCollection("sessions"),
  getPublishedCollection("assessments"),
]);

const lecture = lectures.find((entry) => entry.data.week === week);
const session = sessions.find((entry) => entry.data.week === week);

// Every assessment closing this week, not the first one. A week carries at most
// one for nine of the twelve, which is what made `.find()` look right for a
// year; week 12 closes both the showcase (20%) and Dailies participation (24%)
// on the same Friday, and the strip on /lectures/week-12/ was quietly dropping
// whichever of the two sorted second. ReleaseCalendar.astro learned this
// already and carries the same comment.
const due = assessments
  .filter((entry) => entry.data.week === week)
  .sort(
    (a, b) =>
      a.data.due.getTime() - b.data.due.getTime() || a.data.title.localeCompare(b.data.title),
  );
---

<ul class="week-strip" aria-label={`Week ${week} at a glance`}>
  <li>
    Monday lecture:{" "}
    {lecture ? (
      highlight === "lectures" ? (
        <strong>{lecture.data.title}</strong>
      ) : (
        <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>
      )
    ) : (
      "—"
    )}
  </li>
  <li>
    Wednesday Dailies:{" "}
    {session ? (
      highlight === "sessions" ? (
        <strong>{session.data.title}</strong>
      ) : (
        <a href={withBase(`/sessions/${session.id}/`)}>{session.data.title}</a>
      )
    ) : (
      "—"
    )}
  </li>
  {due.length > 0 && (
    <li>
      Friday due:{" "}
      {due.map((assessment, index) => (
        <Fragment>
          {index > 0 && ", "}
          <a href={withBase(`/assessments/${assessment.id}/`)}>{assessment.data.title}</a>
          {" "}({assessment.data.weight}%)
        </Fragment>
      ))}
    </li>
  )}
</ul>
