---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";

const PHASES = [
  { key: "foundations", title: "Foundations", weeks: "Weeks 1–3", min: 1, max: 3 },
  { key: "anime", title: "Anime", weeks: "Weeks 4–6", min: 4, max: 6 },
  { key: "liveaction", title: "Live Action", weeks: "Weeks 7–9", min: 7, max: 9 },
  { key: "series", title: "The Series", weeks: "Weeks 10–12", min: 10, max: 12 },
] as const;

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const groups = PHASES.map((phase) => ({
  phase,
  lectures: visible.filter((lecture) => lecture.data.week >= phase.min && lecture.data.week <= phase.max),
})).filter((group) => group.lectures.length > 0);
---

{
  groups.map((group) => (
    <Fragment>
      <h2 id={group.phase.key} class={`phase-chip phase-chip--${group.phase.key}`}>
        {group.phase.title} <span class="phase-chip__weeks">{group.phase.weeks}</span>
      </h2>
      <CardGrid columns={3}>
        {group.lectures.map((lecture) => (
          <Card headingLevel="h3" title={lecture.data.title} href={`/lectures/${lecture.id}/`}>
            {lecture.data.description && <p>{lecture.data.description}</p>}
            <p>
              <small>
                Week {lecture.data.week} · {formatCourseDate(lecture.data.date)}
              </small>
            </p>
          </Card>
        ))}
      </CardGrid>
    </Fragment>
  ))
}
