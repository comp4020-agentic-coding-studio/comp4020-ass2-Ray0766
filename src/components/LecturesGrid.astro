---
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";
import { PHASES } from "../lib/phases";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const groups = PHASES.map((phase) => ({
  phase,
  lectures: visible.filter((lecture) => lecture.data.week >= phase.min && lecture.data.week <= phase.max),
})).filter((group) => group.lectures.length > 0);
---

{
  groups.map((group) => (
    <Fragment>
      <h2 id={group.phase.key} class={`phase-chip phase-chip--${group.phase.key}`}>
        {group.phase.title} <span class="phase-chip__weeks">{group.phase.weeks}</span>
      </h2>
      <CardGrid columns={3}>
        {group.lectures.map((lecture) => (
          /* Hand-rolled rather than <Card>, for the same reason
             AssessmentsGrid is: <Card> renders the whole card as the anchor,
             and this card carries two destinations — the lecture and its
             deck. A second <a> inside an <a> is invalid, and the browser
             closes the outer one on the way in rather than telling anyone.
             So the card is a plain container, the title carries the link,
             and the link stretches over the card (site.css) to keep the
             whole surface clickable. Wrapping <Card> in an extra element
             was the other option and it breaks `.at-card-grid > .at-card`'s
             direct-child subgrid rule that aligns rows across columns. */
          <div class="at-card lecture-card">
            <div class="at-card-body">
              <h3 class="at-card-title">
                <a class="lecture-card__link" href={withBase(`/lectures/${lecture.id}/`)}>
                  {lecture.data.title}
                </a>
              </h3>
              {lecture.data.description && <p>{lecture.data.description}</p>}
              <p>
                <small>
                  Week {lecture.data.week} · {formatCourseDate(lecture.data.date)}
                </small>
              </p>
              {lecture.data.slides && (
                <p class="lecture-card__actions">
                  {/* Twelve links reading "Slides" go to twelve different
                      decks, so each gets a name that says which one. The
                      visible word stays inside the accessible name, which is
                      what WCAG's label-in-name asks for. */}
                  <a
                    class="lecture-card__slides"
                    href={withBase(lecture.data.slides)}
                    aria-label={`Slides for Week ${lecture.data.week}`}
                  >
                    Slides
                  </a>
                </p>
              )}
            </div>
          </div>
        ))}
      </CardGrid>
    </Fragment>
  ))
}
