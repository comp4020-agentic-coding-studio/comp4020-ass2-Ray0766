---
import "../../styles/site.css";
import "../../styles/reference-episode.css";
import { RECORDED_CREDIT, referenceEpisode } from "../../lib/studio";
import { toClientReferenceEpisode } from "../../lib/studio-client";

const ref = toClientReferenceEpisode(referenceEpisode);
---

<figure class="reference-episode" id="reference-episode" aria-label={`${ref.title}, reference episode`}>
  <div class="reference-episode__player phone-frame">
    <video src={ref.video} poster={ref.poster} controls preload="none"></video>
  </div>

  <figcaption class="reference-episode__caption">
    <p class="reference-episode__meta">
      {ref.title} · {ref.model} · {ref.mode} · {Math.round(ref.duration_s)}s
    </p>
    <ol class="reference-episode__cards">
      {
        ref.cards.map((card) => (
          <li class="reference-episode__card">
            {card.lines.map((line) => (
              <span class="reference-episode__card-line">{line}</span>
            ))}
          </li>
        ))
      }
    </ol>
    <p class="reference-episode__credit">{RECORDED_CREDIT}</p>
  </figcaption>
</figure>
