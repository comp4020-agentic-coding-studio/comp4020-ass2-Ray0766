---
import { Image } from "astro:assets";
import { getPublishedCollection } from "astro-course-university/content";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroPoster from "../assets/images/hero-home.avif";
import DefaultDarkTheme from "../components/DefaultDarkTheme.astro";
import ReleaseCalendar from "../components/ReleaseCalendar.astro";
import WeightBar from "../components/WeightBar.astro";
import { courseMeta } from "../course-config";
import { PHASES } from "../lib/phases";
import { siteConfig } from "../site-config";
import "../styles/site.css";

const BLURBS: Record<(typeof PHASES)[number]["key"], string> = {
  foundations:
    "Prompting discipline, shot grammar, and the tooling chain from an empty GPU to a usable clip.",
  anime:
    "Stylised motion and cel-shaded compositing: the pipeline that gets a generative model to hold a design.",
  liveaction: "Photoreal continuity, cast consistency, and the coverage a serial drama actually needs.",
  series:
    "Assembly, pacing, and delivery: cutting one season's worth of episodes into a release schedule.",
};

// Convener before Tutor, by the actual role string content declares rather
// than a convenor/tutor/guest/other enum the schema never adopted (role is a
// free-text field, see content.config.ts). Same rule in PeopleGrid.astro and
// people/[slug].astro: render the role string as-is everywhere it appears.
const ROLE_ORDER = ["Convener", "Tutor"];
const team = (await getPublishedCollection("people")).sort(
  (a, b) => ROLE_ORDER.indexOf(a.data.role) - ROLE_ORDER.indexOf(b.data.role),
);

const TEAM_BIOS: Record<string, string> = {
  "vera-lin":
    "Eleven years writing for a daytime soap before the jump to vertical drama; runs Monday lectures on a schedule that does not move for a rewrite.",
  "dutch-meridian":
    "Thirty years directing commercials on the conviction that only the first three seconds are watched; runs Dailies with the same stopwatch.",
};
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <DefaultDarkTheme slot="head" />
  <section class="home-hero" slot="hero" aria-label={`${courseMeta.code}: ${courseMeta.title}`}>
    <div class="home-hero__stage">
      <div class="home-hero__scrim" aria-hidden="true"></div>
      <div class="home-hero__content">
        <p class="home-hero__kicker">{courseMeta.code} · Serialized AI Video Drama</p>
        <h1 class="home-hero__title" aria-label="Slop Opera">
          <span class="home-hero__word home-hero__word--left">Slop</span>
          <span class="home-hero__word home-hero__word--right">Opera</span>
        </h1>
        <div class="home-hero__card">
          <video
            class="home-hero__video"
            muted
            loop
            playsinline
            poster={heroPoster.src}
            width="1080"
            height="1920"
          >
            <source src={withBase("/hero-loop.mp4")} type="video/mp4" />
            <track kind="captions" src={withBase("/hero-loop.vtt")} srclang="en" label="English" default />
          </video>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll(".home-hero__video").forEach((video) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        video.pause();
      } else {
        video.play().catch(() => {});
      }
    });
  </script>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="lead">{courseMeta.description}</p>

  <h2>The four phases</h2>
  <ul class="phase-cards">
    {
      PHASES.map((phase) => (
        <li>
          <a class={`phase-card phase-card--${phase.key}`} href={withBase(`/lectures/#${phase.key}`)}>
            <span class="phase-card__shader" aria-hidden="true" />
            <span class="phase-card__weeks">{phase.weeks}</span>
            <h3 class="phase-card__title">{phase.title}</h3>
            <p class="phase-card__blurb">{BLURBS[phase.key]}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <ReleaseCalendar />

  <h2>Teaching team</h2>
  <ul class="teaching-team">
    {
      team.map((person) => (
        <li>
          <a class="teaching-team__card" href={withBase(`/people/${person.id}/`)}>
            {person.data.photo && (
              <Image
                src={person.data.photo}
                alt={person.data.photoAlt ?? ""}
                width={160}
                height={160}
                class="teaching-team__photo"
              />
            )}
            <span class="teaching-team__name">{person.data.title}</span>
            <span class="teaching-team__role">{person.data.role}</span>
            <p class="teaching-team__bio">{TEAM_BIOS[person.id]}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Assessment at a glance</h2>
  <WeightBar />
  <p class="assessment-glance-link">
    <a href={withBase("/assessments/")}>All four pieces</a>
  </p>

  <p class="home-links">
    <a href={withBase("/policies/")}>Policies</a> · <a href={withBase("/people/")}>People</a>
  </p>
</BaseLayout>
