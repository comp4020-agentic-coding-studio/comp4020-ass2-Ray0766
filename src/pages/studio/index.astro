---
import { withBase } from "astro-theme-university/url";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import DefaultDarkTheme from "../../components/DefaultDarkTheme.astro";
import StudioCanvas from "../../components/studio/StudioCanvas";
import { canvasBundle } from "../../lib/canvas/build";
import { studioWeeks } from "../../lib/studio";
import { toClientWeek, type ClientTier } from "../../lib/studio-client";
import { siteConfig } from "../../site-config";
import "../../styles/site.css";
import "../../styles/studio.css";
import "@xyflow/react/dist/style.css";
import "../../styles/studio-canvas.css";

const weeks = studioWeeks.map(toClientWeek);
const assetPrefix = withBase("/studio/");

// Escaped so a literal "</script" inside a real prompt file (none currently,
// but nothing guarantees it never will) can't close this tag early — the
// browser only ever sees valid JSON text either way.
const payload = JSON.stringify({ bundle: canvasBundle, weeks, assetPrefix }).replace(/<\/script/gi, "<\\/script");

const CREDIT_LINE =
  "Recorded on the convener's rig with MiniMax H3 (local weights), keyframes with NoobAI-XL, reference stills for The Ninth Head with ChatGPT's image generator. Nothing is generated in the browser.";

function inputKindLabel(kind: string): string {
  const labels: Record<string, string> = {
    seed: "Seed",
    prompt: "Prompt",
    image: "Image",
    "image pair": "Image pair",
    "reference set": "Reference set",
    graph: "Workflow graph",
    upscale: "Upscale graph",
    script: "Script",
  };
  return labels[kind] ?? kind;
}

function formatSeed(seed: number | number[] | undefined): string | undefined {
  if (seed === undefined) return undefined;
  return Array.isArray(seed) ? seed.join(", ") : String(seed);
}

function weekAnchor(weekNumber: number): string {
  return `week-${String(weekNumber).padStart(2, "0")}`;
}

// The Dailies link `/studio/#week-05:t1`. The canvas answers that anchor by
// panning to the take; with JS off the same anchor has to land on the same
// take in the gallery, so the id is the anchor itself, colon and all.
function tierAnchor(weekNumber: number, tier: ClientTier): string {
  return `${weekAnchor(weekNumber)}:${tier.tier}`;
}

const takeIdByTier = new Map(
  canvasBundle.doc.nodes.flatMap((node) =>
    node.type === "take" ? [[node.tierId, node.takeId] as const] : [],
  ),
);

// The Cut and the reference episode are boards on the canvas too, so with JS
// off they have to be in the gallery as well — read straight off the same
// document the canvas draws, rather than restated here from the manifests.
function boardSection(boardId: string) {
  const board = canvasBundle.doc.boards.find((candidate) => candidate.id === boardId);
  const nodes = canvasBundle.doc.nodes.filter((node) => node.boardId === boardId);
  return {
    id: boardId,
    title: board?.title ?? boardId,
    week: board?.week,
    takes: nodes.flatMap((node) =>
      node.type === "take" ? [{ node, meta: canvasBundle.meta[node.id] ?? {} }] : [],
    ),
    inputs: nodes.flatMap((node) =>
      node.type === "input" ? [{ node, meta: canvasBundle.meta[node.id] ?? {} }] : [],
    ),
  };
}

const cutSection = boardSection("cut");
const referenceSection = boardSection("reference");
---

<ContentLayout
  title="Studio"
  description="The whole rig as one canvas: every recorded input, every take it produced, and the line between them. Nothing here is produced in the browser — every result is the exact file the rig recorded."
  {...siteConfig}
>
  <DefaultDarkTheme slot="head" />

  <p>
    Every clip and still here is a real recorded result from the course's own
    production rig, not a live model call. On a wide screen the canvas lays
    the whole rig out as boards — one per week, plus the Cut and the reference
    episode — with an edge from each input to the take it produced, and a desk
    that replays what the rig recorded for whatever you put on it. On a phone
    the desk is a form and the results are the list below. {CREDIT_LINE}
  </p>

  <nav class="studio-index" aria-label="Everything in the Studio">
    <ul>
      {
        weeks.map((week) => (
          <li>
            <a href={`#${weekAnchor(week.week)}`}>
              Week {week.week} — {week.instrument}
            </a>
          </li>
        ))
      }
      <li>
        <a href={withBase("/cut/")}>The Cut</a>
      </li>
      <li>
        <a href={withBase("/lectures/week-10/#reference-episode")}>Reference episode</a>
      </li>
    </ul>
  </nav>

  <script type="application/json" is:inline data-studio-canvas-payload set:html={payload} />

  <section class="studio-canvas" data-studio-canvas hidden aria-label="Lineage canvas">
    <StudioCanvas client:visible />
  </section>

  {/* The desk at phone size, where there is no canvas to take references off
      — same manifests, same resolver, same recorded backend, a few kilobytes
      of plain DOM instead of the React island. */}
  <section class="studio-form" data-studio-form hidden aria-label="Desk">
    <h2>Desk</h2>
    <p>
      Pick a recorded run and the rig replays it. The prompt below is the one the rig was actually
      given; change it and the rig will say so rather than make something up.
    </p>

    <div class="studio-form__pickers">
      <label class="studio-form__label">
        Week
        <select class="studio-form__select" data-form-week></select>
      </label>
      <label class="studio-form__label">
        Tier
        <select class="studio-form__select" data-form-tier></select>
      </label>
    </div>

    <p class="studio-form__kind" data-form-kind></p>

    <label class="studio-form__label">
      Prompt
      <textarea class="studio-form__prompt" data-form-prompt rows="8"></textarea>
    </label>

    <div class="studio-form__run">
      <button type="button" class="at-button" data-form-generate>Generate</button>
      <button type="button" class="at-button at-button--outline" data-form-restore hidden>
        Use the recorded input
      </button>
    </div>

    <p class="studio-form__status" role="status" data-form-status></p>
    <pre class="studio-form__recorded" data-form-recorded hidden></pre>
    <progress class="studio-form__progress" data-form-progress max="100" value="0"></progress>

    <figure class="studio-form__result" data-form-result hidden>
      <video class="studio-form__media" data-form-video hidden controls playsinline preload="metadata"></video>
      <img class="studio-form__media" data-form-image hidden alt="" />
      <figcaption data-form-caption></figcaption>
    </figure>

    <p class="studio-form__line" data-form-line></p>

    <button type="button" class="at-button at-button--outline" data-form-download hidden>
      Download production log
    </button>
  </section>

  <section class="studio-gallery" aria-label="Every recorded result, in order">
    <h2 class="studio-gallery__heading">Every recorded result, in order</h2>
    {
      weeks.map((week) => (
        <div class="studio-gallery__week" id={weekAnchor(week.week)}>
          <h3>
            Week {week.week} — {week.instrument}
          </h3>
          <p class="studio-gallery__meta">
            {week.model} · {week.mode} · {week.resolution}
            {formatSeed(week.seed) ? ` · seed ${formatSeed(week.seed)}` : ""}
          </p>
          <ol class="studio-gallery__tiers">
            {week.tiers.map((tier) => (
              <li class="studio-gallery__tier" id={tierAnchor(week.week, tier)}>
                <h4>
                  {tier.tier} — {tier.label}
                </h4>
                <p class="studio-gallery__address">{takeIdByTier.get(tier.id)}</p>
                <div class="studio-gallery__grid">
                  <div class="studio-gallery__input">
                    <p class="studio-gallery__kind">{inputKindLabel(tier.input.kind)}</p>
                    {typeof tier.input.value === "number" && <p>Seed: {tier.input.value}</p>}
                    {tier.input.files?.length ? (
                      <div class="studio-gallery__input-files">
                        {tier.input.files.map((file) =>
                          file.endsWith(".graph.json") ? (
                            <a href={file} class="at-button at-button--outline">
                              Download workflow graph
                            </a>
                          ) : file.endsWith(".mp4") ? (
                            <video class="studio-gallery__media" src={file} controls preload="metadata" />
                          ) : (
                            <img
                              class="studio-gallery__media"
                              src={file}
                              alt={`Input still for ${tier.label}`}
                              loading="lazy"
                            />
                          ),
                        )}
                      </div>
                    ) : null}
                    {tier.input.promptText && <pre class="studio-gallery__text">{tier.input.promptText}</pre>}
                    {tier.input.negText && (
                      <>
                        <p class="studio-gallery__neg-label">Negative prompt</p>
                        <pre class="studio-gallery__text">{tier.input.negText}</pre>
                      </>
                    )}
                  </div>
                  <div class="studio-gallery__output">
                    {tier.output.kind === "video" ? (
                      <video
                        class="studio-gallery__media"
                        src={tier.output.file}
                        poster={tier.output.poster}
                        controls
                        preload="metadata"
                      />
                    ) : (
                      <img
                        class="studio-gallery__media"
                        src={tier.output.file}
                        alt={`Recorded output for ${tier.label}`}
                        loading="lazy"
                      />
                    )}
                    {tier.output.cuts?.length ? (
                      <p class="studio-gallery__cuts">
                        Delivered as {tier.output.cuts.length} cut clips:{" "}
                        {tier.output.cuts.map((cut, index) => (
                          <>
                            <a href={cut}>{`clip ${index + 1}`}</a>
                            {index < tier.output.cuts!.length - 1 ? ", " : ""}
                          </>
                        ))}
                      </p>
                    ) : null}
                  </div>
                </div>
                <p class="studio-gallery__note">{tier.note}</p>
                {tier.sameAs && <p class="studio-gallery__sameas">Same recorded result as {tier.sameAs}.</p>}
                {tier.counterExample && <p class="studio-gallery__counter">Deliberate counter-example.</p>}
              </li>
            ))}
          </ol>
        </div>
      ))
    }

    {
      [cutSection, referenceSection].map((section) => (
        <div class="studio-gallery__week" id={section.id}>
          <h3>{section.title}</h3>
          <p class="studio-gallery__meta">
            Taught in week {section.week}
          </p>
          <ol class="studio-gallery__tiers">
            {section.inputs.map((entry) => (
              <li class="studio-gallery__tier">
                <h4>{entry.node.type === "input" ? entry.node.label : ""}</h4>
                {entry.meta.promptText ? <pre class="studio-gallery__text">{entry.meta.promptText}</pre> : null}
                {entry.meta.note ? <p class="studio-gallery__note">{entry.meta.note}</p> : null}
              </li>
            ))}
            {section.takes.map((entry) => (
              <li class="studio-gallery__tier">
                <h4>{entry.meta.tier ?? "Take"}</h4>
                <p class="studio-gallery__address">{entry.node.type === "take" ? entry.node.takeId : ""}</p>
                <div class="studio-gallery__output">
                  {entry.node.type === "take" && entry.node.media === "video" ? (
                    <video
                      class="studio-gallery__media"
                      src={entry.node.file}
                      poster={entry.node.poster}
                      controls
                      preload="metadata"
                    />
                  ) : entry.node.type === "take" ? (
                    <img class="studio-gallery__media" src={entry.node.file} alt="" loading="lazy" />
                  ) : null}
                </div>
                {entry.meta.note ? <p class="studio-gallery__note">{entry.meta.note}</p> : null}
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>

  <script is:inline>
    // See site.css: hold each section's space open during parsing so
    // revealing it on a slow connection doesn't shove the gallery down.
    // Inline, so a JS-off reader gets neither a reservation nor an empty hole.
    document.querySelector("[data-studio-canvas]")?.setAttribute("data-reserve", "studio-canvas");
    document.querySelector("[data-studio-form]")?.setAttribute("data-reserve", "studio-form");
  </script>

  <script src="../../scripts/studio/desk-form.ts"></script>
</ContentLayout>
